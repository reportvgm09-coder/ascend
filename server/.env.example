# Copy to server/.env and fill in. Everything is optional for local use.
# Required when deployed (NODE_ENV=production): the password you log in with.
APP_PASSWORD=
# Hosted database (Turso). Leave empty to use a local SQLite file in server/data.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Enables the AI coach. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: stable session signing secret (generated automatically otherwise)
# JWT_SECRET=
