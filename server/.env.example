# Copy to server/.env and fill in.
# Required when deployed (NODE_ENV=production): the password you log in with.
APP_PASSWORD=
# Optional: enables the AI coach. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: where the SQLite database lives (default: server/data)
# DATA_DIR=/data
# Optional: stable session signing secret (generated automatically otherwise)
# JWT_SECRET=
